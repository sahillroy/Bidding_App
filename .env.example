# ---------------------------------------------------------------------------
# BidKar environment variables
#
# Copy this file to .env.local, or run `npm run setup:local` and let the script
# do it. .env.local is gitignored and must never be committed.
#
# The Supabase JWTs below are the published local-CLI demo keys. They look
# like real tokens because they are the ones `supabase start` prints on every
# machine. They unlock only a Docker stack on localhost. A hosted project's
# service role key must never be committed here.
# ---------------------------------------------------------------------------

# --- Supabase (local Docker stack) ----------------------------------------
# These three values are the published Supabase CLI demo keys. They are the
# same on every machine that runs `supabase start` and they are not secrets.
# `npm run setup:local` writes them into .env.local for you.
#
# The anon key is safe in the browser: it is constrained by Row Level Security.
# The service role key bypasses RLS. It is still only a local-stack key here,
# but it must never be prefixed NEXT_PUBLIC_ and never imported into a client
# component. A hosted project's service role key is a different matter — treat
# a leak of THAT as a full database compromise.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# --- Upstash QStash (Phase 5: scheduled auction closure) -------------------
# QSTASH_TOKEN publishes delayed messages. The two signing keys verify that an
# inbound request to /api/internal/* genuinely came from QStash and not from an
# attacker who guessed the URL. Both are needed because QStash rotates keys.
QSTASH_TOKEN=eyJVc2VySUQiOiJkdW1teSIsIlBhc3N3b3JkIjoiZHVtbXkifQ==
QSTASH_CURRENT_SIGNING_KEY=sig_dummy_current
QSTASH_NEXT_SIGNING_KEY=sig_dummy_next

# --- App ------------------------------------------------------------------
# Absolute origin. QStash callbacks are built from this, so it must be publicly
# reachable in any environment where auctions actually close.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Controls demo-only affordances (seeded data, the time-travel helper).
# The DEMO banner does NOT read this: the banner is unconditional by design, so
# that a misconfigured environment cannot remove the notice. Never set false.
NEXT_PUBLIC_DEMO_MODE=true

# --- Optional -------------------------------------------------------------
# Transactional email (Phase 7): outbid, auction won, payment deadline.
RESEND_API_KEY=re_dummy_key

# Razorpay TEST MODE ONLY (Phase 6). Test keys never touch real money and are
# free without company registration. A live key (rzp_live_*) must never appear
# in this project — see implementationplan.md §2.2.
RAZORPAY_TEST_KEY_ID=rzp_test_dummy
RAZORPAY_TEST_KEY_SECRET=dummy_secret

# --- Integration tests (RLS suite) ----------------------------------------
# Point these at a LOCAL `supabase start` stack, never at production: the RLS
# suite creates and deletes users. When unset, tests/integration/rls.test.ts
# skips rather than fails, so the unit suite still runs on a machine with no
# database. Phase 1 is not complete until these are set and the suite passes.
SUPABASE_TEST_URL=http://127.0.0.1:54321
SUPABASE_TEST_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_TEST_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
